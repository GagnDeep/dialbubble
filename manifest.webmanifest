{"name":"Dialbubble","short_name":"Dialbubble","description":"Dialbubble is a free iPhone app for calling and texting from your own Twilio account and numbers. No server, no Dialbubble account, no subscription and no markup. You pay Twilio its normal usage rates.","start_url":"/dialbubble/","scope":"/dialbubble/","display":"browser","background_color":"#04100E","theme_color":"#173B35","icons":[{"src":"/dialbubble/icons/icon-192.png","sizes":"192x192","type":"image/png"},{"src":"/dialbubble/icons/icon-512.png","sizes":"512x512","type":"image/png"},{"src":"/dialbubble/icons/icon-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}]}